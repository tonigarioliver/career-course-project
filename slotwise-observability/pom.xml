<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.slotwise</groupId>
        <artifactId>slotwise-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>slotwise-observability</artifactId>
    <packaging>jar</packaging>

    <name>slotwise-observability</name>
    <description>Tracing (OpenTelemetry through Micrometer Tracing) and structured ECS logs shared by the services: dependencies plus default properties</description>

    <dependencies>
        <!-- @AutoConfiguration and the @Conditional* annotations (OpenTelemetryLogbackAutoConfiguration). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Tracing: traceId/spanId in the MDC, propagated through HTTP and Kafka headers. OTLP export to the Collector below. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <!-- The OpenTelemetry SDK bean the tracing autoconfiguration needs (API + SDK only). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Ships the spans over OTLP (to the OpenTelemetry Collector, see docker-compose.yml). -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Captures Logback events as OpenTelemetry log records (shipped by the OTLP log exporter Spring Boot configures).
             2.21.0-alpha is the instrumentation release built against OpenTelemetry SDK 1.55.0, the one Boot 4.0.1 manages. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>2.21.0-alpha</version>
        </dependency>
        <!-- Needed to compile against the appender; every service already has Logback through its starters. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- HTTP server observation (WebMvcObservationAutoConfiguration) needs MetricsProperties from here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-metrics</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
